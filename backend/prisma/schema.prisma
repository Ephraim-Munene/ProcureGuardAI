datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String
  role      String    @default("AUDITOR") // AUDITOR, ADMIN
  invoices  Invoice[]
  createdAt DateTime  @default(now())
}

model Invoice {
  id                 String        @id @default(uuid())
  userId             String
  user               User          @relation(fields: [userId], references: [id])
  invoiceNumber      String
  vendorName         String
  fileUrl            String
  totalAmountKes     Float
  overallRiskScore   Float         // 0.0 to 100.0
  riskLevel          String        // LOW, MEDIUM, HIGH, CRITICAL
  status             String        @default("FLAGGED") // CLEAN, FLAGGED, RESOLVED
  summaryNotes       String
  items              InvoiceItem[]
  createdAt          DateTime      @default(now())
}

model InvoiceItem {
  id                   String    @id @default(uuid())
  invoiceId            String
  invoice              Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description          String
  quantity             Int
  invoicedUnitPriceKes Float
  marketUnitPriceKes   Float
  inflationPercentage  Float
  isFlagged            Boolean   @default(false)
  flagReason           String?
  riskLevel            String    // LOW, MEDIUM, HIGH, CRITICAL
}

model BenchmarkPrice {
  id                   String   @id @default(uuid())
  itemName             String   @unique
  category             String   // e.g., Stationery, Hardware, Electronics
  averageMarketPriceKes Float
  maxAllowedPriceKes   Float
  updatedAt            DateTime @updatedAt
}
